# Copy to .env and fill in. GROQ_API_KEY is required for Q&A (uploads/indexing work without it).
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=medium     # low | medium | high
# GROQ_MAX_TOKENS=8192             # reasoning tokens count against this
# GROQ_TIMEOUT_S=60
# MAX_UPLOAD_MB=50
# OCR_ENABLED=true
# RETRIEVAL_CANDIDATES=20          # per-retriever pool before RRF fusion
# RERANK_ENABLED=true              # local cross-encoder over the fused candidates
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_THRESHOLD=0.10             # drop chunks scoring below this; may send the LLM fewer than top_k
# RERANK_CANDIDATES=20             # fused chunks the cross-encoder scores; top_k of them go to the LLM
